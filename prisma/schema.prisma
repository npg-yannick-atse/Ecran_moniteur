generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Of {
  id_of                         Int                         @id(map: "PK__Of__0148BB9CC61677FB") @default(autoincrement())
  of                            String                      @db.NVarChar(15)
  quantite                      Float?
  qte_ctr_recept_logistique     Float?
  qte_pce_recept_logistique     Float?
  qte_livrer_semi               Float?
  date_recept_logistique        DateTime?                   @db.DateTimeOffset
  unite                         String                      @db.NVarChar(15)
  process                       String?                     @db.NVarChar(15)
  debut_ordonnancement          DateTime?                   @db.DateTimeOffset
  date_creation_of              DateTime?                   @db.Date
  heure_creation_of             DateTime?                   @db.Time
  section_code                  String?                     @db.NVarChar(5)
  section_nom                   String?                     @db.NVarChar(50)
  poste_travail                 String?                     @db.NVarChar(12)
  code_article                  String?                     @db.NVarChar(20)
  designation_article           String?                     @db.NVarChar(100)
  zone_tampon                   String?                     @db.NVarChar(6)
  magasin                       String?                     @db.NVarChar(10)
  type_article                  String?                     @db.NVarChar(6)
  gestionnaire                  String?                     @db.NVarChar(6)
  colisage                      Float?
  gerbage                       Int?
  numero_lo                     String?                     @db.NVarChar(10)
  division                      String?                     @db.NVarChar(10)
  download_by                   String?                     @db.NVarChar(100)
  date_Livraison                DateTime?                   @db.DateTimeOffset
  createdAt                     DateTime                    @db.DateTimeOffset
  updatedAt                     DateTime                    @updatedAt @db.DateTimeOffset
  id_status_FK                  Int?
  id_statusUtilisateur_FK       Int?
  qte_remplir                   Float?
  qte_polypacker                Float?
  qte_livrer                    Float?
  id_status_production          Int?
  of_secondary                  String?                     @db.NVarChar(15)
  numero_lot_controle           String?                     @db.NVarChar(20)
  fiche_anomalie                Int?
  nb_effectif                   String?                     @db.NVarChar(10)
  cadence                       String?                     @db.NVarChar(10)
  base_temps                    String?                     @db.NVarChar(10)
  temps_changement              String?                     @db.NVarChar(10)
  date_fin_ordonnancement       DateTime?                   @db.Date
  date_debut_ordonnancement     DateTime?                   @db.Date
  heure_fin_ordonnancement      DateTime?                   @db.Time
  heure_debut_ordonnancement    DateTime?                   @db.Time
  commentaire_demande_composant String?                     @db.NVarChar(500)

  @@map("Of")
}

model of_item {
  id_of_item                Int       @id @default(autoincrement())
  of                        String    @db.NVarChar(12)
  code_article              String    @db.NVarChar(18)
  groupe_march              String?   @db.NVarChar(9)
  type_article              String?   @db.NVarChar(20)
  designation_article       String?   @db.NVarChar(40)
  quantite                  Float?
  unite                     String?   @db.NVarChar(3)
  magasin                   String?   @db.NVarChar(4)
  batch                     String?   @db.NVarChar(20)
  type_poste                String?   @db.Char(1)
  numero_poste              String?   @db.NVarChar(6)
  numero_reservation        String?   @db.NVarChar(10)
  numeroPost_reservation    String?   @db.NVarChar(4)
  qte_requise               Float?
  qte_prepare               Float?
  qte_transfere             Float?
  qte_receptionne           Float?
  qte_transfere_cnd         Float?
  qte_consomme              Float?
  qte_restant_cnd           Float?
  qte_restant_zone          Float?
  date_Livraison            DateTime? @db.DateTimeOffset
  annuler                   Int?
  annuler_preparation       Int?
  annuler_transfere         Int?
  annuler_reception         Int?
  createdAt                 DateTime  @db.DateTimeOffset
  updatedAt                 DateTime  @db.DateTimeOffset
  id_of_FK                  Int?
  id_status_FK              Int?
  id_status_production      Int?
  zone_tampon               String?   @db.NVarChar(6)

  @@map("of_item")
}


model Process {
  id_process      Int              @id(map: "PK__process__4D1766E0CD51D56E") @default(autoincrement())
  code            String?          @db.NVarChar(20)
  designation     String?          @db.NVarChar(255)
  ligne           String?          @db.NVarChar(20)
  type            String?          @db.NVarChar(5)
  min             Int?
  max             Int?
  order           Int?
  id_zone_FK      Int?
  poste_technique String?          @db.NVarChar(20)
  access_control_id    Int?
  nombre_effectif      Int?
  of_current_process   String?   @db.NVarChar(255)

  @@map("process")
}

model fiche_cheminement {
  id_fiche             Int       @id(map: "PK__fiche_ch__427B0F8EAC8D3235") @default(autoincrement())
  remplissage          Int?
  qte_remplissage      Float?    @db.Float(53)
  remplissage_by       String?   @db.NVarChar(100)
  remplissage_date     DateTime? @db.DateTimeOffset
  polypackage          Int?
  qte_polypackage      Float?    @db.Float(53)
  polypackage_by       String?   @db.NVarChar(100)
  polypackage_date     DateTime? @db.DateTimeOffset
  livraison            Int?
  qte_livraison        Float?    @db.Float(53)
  livraison_by         String?   @db.NVarChar(100)
  livraison_date       DateTime? @db.DateTimeOffset
  impression           Int?
  qte_impression       Float?    @db.Float(53)
  unite                String?   @db.NVarChar(10)
  impression_by        String?   @db.NVarChar(100)
  impression_date      DateTime? @db.DateTimeOffset
  annuler              Int?
  annuler_by           String?   @db.NVarChar(50)
  annuler_date         DateTime? @db.DateTimeOffset
  created_by           String?   @db.NVarChar(100)
  indice               Int?
  qrCode               String?   @db.NVarChar(255)
  ref                  String?   @db.NVarChar(255)
  createdAt            DateTime  @db.DateTimeOffset
  updatedAt            DateTime  @db.DateTimeOffset
  id_of_FK             Int?
  reception_livraison  Int?
  qte_receptionne      Float?    @db.Float(53)
  receptionn_by        String?   @db.NVarChar(100)
  reception_date       DateTime? @db.DateTimeOffset
  duree_production     Int?
}

model of_has_status {
  id              Int       @id @default(autoincrement())
  created_by      String?   @db.NVarChar(50)
  commentaire     String?   @db.NVarChar(255)
  quantite        Float?
  unite           String?   @db.NVarChar(6)
  annuler         Int?
